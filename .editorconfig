root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true

[*.{csproj,props,targets,json,jsonc,yml,yaml}]
indent_style = space
indent_size = 2

[*.{ts,vue,scss}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
