<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <BuildChannel Condition="'$(BuildChannel)' == ''">development</BuildChannel>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BuildRevision" Value="$(BuildRevision)" />
    <AssemblyMetadata Include="BuildChannel" Value="$(BuildChannel)" />
    <InternalsVisibleTo Include="Lexarbor.Service.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Mapster" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lexarbor.Service\Lexarbor.Service.csproj" />
    <ProjectReference Include="..\Lexarbor.Database\Lexarbor.Database.csproj" />
  </ItemGroup>
</Project>
