{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Database": {
    "InitializeOnStartup": true
  },
  "IdentityService": {
    "Authority": "http://localhost:8080",
    "Issuer": "http://localhost:8080",
    "Audience": "lexarbor"
  },
  "AdminAuthentication": {
    "RequiredRole": "admin",
    "OidcCode": {
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "",
      "PostLogoutRedirectUri": "",
      "Scope": "openid profile"
    }
  },
  "RateLimits": {
    "AdminLogin": { "Enabled": true, "PermitLimit": 10, "WindowSeconds": 300 },
    "PublicApi": { "Enabled": true, "PermitLimit": 300, "WindowSeconds": 60 }
  },
  "Network": {
    "TrustedProxies": [],
    "TrustedNetworks": [],
    "ForwardLimit": 1
  },
  "ConnectionStrings": {
    "Default": "Data Source=data/vocabulary.db"
  },
  "Audio": {
    "Enabled": false,
    "InternalEndpoint": "",
    "PublicEndpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "Region": "us-east-1",
    "Bucket": "lexarbor-audio",
    "KeyPrefix": "audio/",
    "PlaybackTtlSeconds": 900,
    "MaxUploadBytes": 5242880,
    "MaxConcurrentUploads": 2,
    "MaxQueuedUploads": 8,
    "OperationTimeoutSeconds": 60
  }
}
