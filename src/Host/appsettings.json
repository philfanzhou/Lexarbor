{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Grafana.Loki"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://ruoyu-loki:3100",
          "labels": [{ "key": "service", "value": "Ruoyu.Study.Vocabulary" }]
        }
      }
    ]
  },
  "Loki": {
    "Uri": "http://localhost:3100"
  },
  "Consul": {
    "Host": "host.docker.internal",
    "Port": 8500,
    "ServiceName": "Ruoyu.Study.Vocabulary",
    "KvPrefix": "config/ruoyu",
    "TimeoutMs": 3000,
    "RetryCount": 3,
    "EnableCache": true,
    "CacheDirectory": "./data/consul"
  },
  "Database": {
    "Name": "ruoyu_study_vocabulary"
  },
  "IdentityService": {
    "Authority": "http://localhost:5002",
    "Issuer": "QuantumZhou.Identity",
    "Audience": "QuantumZhou.microservices",
    "AppId": "",
    "AppSecret": ""
  },
  "AdminAuthentication": {
    "CookieName": "ruoyuVocabularyAdmin",
    "CookieSecure": false
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=ruoyu_study_vocabulary;Username=phil"
  }
}
