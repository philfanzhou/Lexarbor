{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Grafana.Loki"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://ruoyu-loki:3100",
          "labels": [{ "key": "service", "value": "Ruoyu.Study.Vocabulary" }]
        }
      }
    ]
  },
  "Loki": {
    "Uri": "http://localhost:3100"
  },
  "Consul": {
    "Host": "host.docker.internal",
    "Port": 8500,
    "ServiceName": "Ruoyu.Study.Vocabulary",
    "KvPrefix": "config/ruoyu",
    "TimeoutMs": 3000,
    "RetryCount": 3,
    "EnableCache": true,
    "CacheDirectory": "./data/consul"
  },
  "AuthSettings": {
    "AdminClientSecret": "234565424234234"
  },
  "ConnectionStrings": {
    "Value": "C:\\MyData"
  }
}